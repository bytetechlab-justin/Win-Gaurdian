{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    },
    "EventLog": {
      "SourceName": "WinGuardian",
      "LogName": "Application",
      "LogLevel": {
        "Default": "Information",
        "Microsoft": "Warning"
      }
    }
  },
  "Guardian": {
    "ScanRoots": [ "%WINDIR%" ],
    "WatchRoots": [ "%WINDIR%" ],
    "ExcludedPaths": [
      "%WINDIR%\\Temp",
      "%WINDIR%\\Logs",
      "%WINDIR%\\Prefetch",
      "%WINDIR%\\SoftwareDistribution",
      "%WINDIR%\\ServiceProfiles",
      "%WINDIR%\\ServiceState",
      "%WINDIR%\\System32\\config",
      "%WINDIR%\\System32\\LogFiles",
      "%WINDIR%\\System32\\winevt",
      "%WINDIR%\\System32\\sru",
      "%WINDIR%\\System32\\wbem\\Repository",
      "%WINDIR%\\System32\\catroot2",
      "%WINDIR%\\System32\\spool\\PRINTERS",
      "%WINDIR%\\WinSxS\\Temp",
      "%WINDIR%\\WinSxS\\ManifestCache",
      "%WINDIR%\\CbsTemp",
      "%WINDIR%\\tracing",
      "%WINDIR%\\appcompat",
      "%WINDIR%\\System32\\Tasks"
    ],
    "ExcludedExtensions": [ ".log", ".etl", ".tmp", ".evtx", ".pf", ".blf", ".regtrans-ms" ],
    "MaxHashFileSizeMB": 256,
    "HashThreads": 4,
    "ProcessPollSeconds": 5,
    "ServicePollSeconds": 30,
    "PersistencePollSeconds": 30,
    "NetworkPollSeconds": 5,
    "FullScanIntervalHours": 24,
    "FileChangeDebounceMs": 2000,
    "ScheduledTasksRoot": "%WINDIR%\\System32\\Tasks",
    "TaskRiskPrivilegedMultiplierPercent": 150,
    "TaskRiskMediumThreshold": 3,
    "TaskRiskHighThreshold": 6,
    "TaskRiskWeights": {}
  }
}
