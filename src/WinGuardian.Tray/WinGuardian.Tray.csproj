<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>WinGuardian.Tray</RootNamespace>
    <AssemblyName>WinGuardian.Tray</AssemblyName>
    <Version>0.6.0</Version>
    <ApplicationIcon>Assets\WinGaurdian.ico</ApplicationIcon>
    <!-- Windows shows the file description as the app name in notifications and Task Manager. -->
    <AssemblyTitle>WinGaurdian</AssemblyTitle>
    <Product>WinGaurdian</Product>
    <Company>WinGaurdian</Company>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\WinGuardian.Core\WinGuardian.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\logo.png" LogicalName="logo.png" />
    <EmbeddedResource Include="Assets\shield.png" LogicalName="shield.png" />
    <EmbeddedResource Include="Assets\WinGaurdian.ico" LogicalName="app.ico" />
  </ItemGroup>

</Project>
